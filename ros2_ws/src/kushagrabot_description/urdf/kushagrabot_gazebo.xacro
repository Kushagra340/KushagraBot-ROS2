<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base Link -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Left Wheel -->
  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
    <!-- High friction for driving wheels -->
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Right Wheel -->
  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
    <!-- High friction for driving wheels -->
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Castor Wheel -->
  <gazebo reference="castor_wheel">
    <material>Gazebo/Grey</material>
    <!-- Low friction so it slides freely instead of creating resistance -->
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- Differential Drive Plugin for Gazebo Classic (ROS 2 Humble) -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_safe</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.136</wheel_separation>
      <wheel_diameter>0.034</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>50.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
    <plugin name="kushagrabot_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Left ToF Sensor Plugin -->
  <gazebo reference="left_tof_link">
    <sensor type="ray" name="left_tof_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.03</min>
          <max>1.2</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="left_tof_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=left_tof/range</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>left_tof_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Right ToF Sensor Plugin -->
  <gazebo reference="right_tof_link">
    <sensor type="ray" name="right_tof_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle>0.01</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.03</min>
          <max>1.2</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="right_tof_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=right_tof/range</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>right_tof_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 360-Degree LiDAR Plugin -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
